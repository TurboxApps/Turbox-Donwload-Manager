{
  "manifest_version": 3,
  "name": "Turbo X 8K/4K Downloader (Firefox)",
  "version": "2.5.0",
  "description": "High-Speed Download Accelerator & 8K/4K/MP3 Video Downloader Integration for Mozilla Firefox.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Turbo X 8K/4K Downloader (Firefox)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": [
    "downloads",
    "contextMenus",
    "storage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "turbox-integration@turbox.app",
      "strict_min_version": "109.0"
    }
  }
}
